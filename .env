# ============================================
# IBKR API Configuration
# ============================================
IBKR_API_URL=http://localhost:5000/api/v1
IBKR_ACCOUNT=YOUR_ACCOUNT_ID
IBKR_PASSWORD=YOUR_PASSWORD

# ============================================
# Scanner Configuration Parameters
# ============================================
# Minimum profit percentage required
MIN_PROFIT=1.0

# Maximum Delta for Out-of-the-Money options (0.0 - 1.0)
# 0.30 = 30% probability of expiring in-the-money
MAX_DELTA=0.30

# Minimum days to expiration
MIN_DAYS=20

# Maximum days to expiration
MAX_DAYS=63

# Number of top options to display per stock
TOP_N=10

# ============================================
# NASDAQ Stocks from Optionen-Watchlist.csv
# ============================================
NASDAQ_SYMBOLS=AAPL,ABT,AMD,AMZN,ANET,APH,CCJ,CRWD,DELL,ELF,FCX,GDX,GLD,GOOGL,HIMS,HOOD,IBIT,MARA,MDLZ,META,MRK,MRVL,NEM,NKE,NVDA,NVO,PANW,PEP,PLTR,QCOM,SLV,UBER,VRT,XOM

# ============================================
# Display Settings
# ============================================
# Log level: trace, debug, info, warn, error
LOG_LEVEL=trace

# Output format: json, text
OUTPUT_FORMAT=text

# Save results to file
SAVE_RESULTS=true
RESULTS_FILE=./option_scan_results.json

# ============================================
# Performance Settings
# ============================================
# Number of concurrent API requests
CONCURRENT_REQUESTS=5

# Request timeout in seconds
REQUEST_TIMEOUT=30

# Retry attempts on failure
MAX_RETRIES=3
