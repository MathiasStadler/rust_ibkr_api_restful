# ============================================
# IBKR API Configuration
# ============================================
IBKR_API_URL=http://localhost:5000/api/v1
IBKR_ACCOUNT=YOUR_ACCOUNT_ID
IBKR_PASSWORD=YOUR_PASSWORD

# ============================================
# Scanner Configuration Parameters
# ============================================
# Minimum profit percentage required
MIN_PROFIT=1.0

# Maximum Delta for Out-of-the-Money options (0.0 - 1.0)
# 0.30 = 30% probability of expiring in-the-money
MAX_DELTA=0.30

# Minimum days to expiration
MIN_DAYS=20

# Maximum days to expiration
MAX_DAYS=45

# Number of top options to display per stock
TOP_N=10

# ============================================
# NASDAQ Stocks with Active Options Trading
# ============================================
# Technology - Mega Cap (8)
NASDAQ_SYMBOLS=AAPL,MSFT,GOOGL,GOOG,AMZN,NVDA,META,TSLA,\
# Technology - Large Cap (18)
NFLX,ADBE,CSCO,INTC,AMD,AVGO,QCOM,ASML,LRCX,KLAC,ANET,CRWD,NET,DDOG,FTNT,ZS,PYPL,INTU,\
# Software & Cloud (15)
CRM,ORCL,SNOW,DOCN,OKTA,ZOOM,TWLO,ROKU,SHOP,MELI,PINS,SPLK,TEAM,RPD,DB,\
# AI & Semiconductors (7)
ARM,SUPER,MSTR,COIN,MARA,RIOT,CLSK,\
# Communication Services (5)
CMCSA,CHTR,TMUS,VZ,T,\
# Healthcare & Biotech (8)
AMGN,BIIB,REGN,ILMN,VEEV,DXCM,TDOC,JNJ,\
# E-Commerce & Retail (7)
EBAY,BKNG,EXPE,DKNG,DASH,UBER,LYFT,\
# Financial Services (6)
SOFI,UPST,AFRM,SQ,ABNB,HOOD,\
# Energy & Utilities (6)
ENPH,RUN,SEDG,NEE,DUK,SO,\
# Industrial & Transportation (4)
BA,GE,CSCO,RTX,\
# Consumer (6)
AMZN,COST,MCD,SBUX,NKE,LULU,\
# Semiconductors & Hardware (8)
XLNX,MU,NVTA,SWKS,JBLU,ARCB,SMCI,DELL,\
# Additional Major NASDAQ (12)
HPQ,PTC,SNPS,CDNS,MSCI,RBLX,MNST,PAYX,VRSN,NTAP,AVGO,AMAT,\
# Healthcare Tech (8)
VEEV,DXCM,TDOC,EMDEON,EDIT,CRSP,BEAM,BMRN,\
# Financial Tech (7)
PAYC,ADP,ADSK,WDAY,NOW,CCI,EQIX,\
# E-Payment & Digital (8)
V,MA,DFS,AXP,SQ,PYPL,SOFI,AFRM,\
# Media & Entertainment (7)
NFLX,ROKU,MTCH,ZNGA,SPOT,RBLX,FUTU,\
# Telecom & Wireless (5)
TMUS,VZWIX,CMCSA,CHTR,VZ,\
# Transportation & Logistics (6)
UBER,LYFT,UPS,FDX,JBLU,AAL,\
# Automotive (4)
TSLA,NIO,XPEV,LI,\
# Cybersecurity (8)
CRWD,ZS,FTNT,OKTA,NET,DDOG,PALO,SPLK

# ============================================
# Display Settings
# ============================================
# Log level: trace, debug, info, warn, error
LOG_LEVEL=info

# Output format: json, text
OUTPUT_FORMAT=text

# Save results to file
SAVE_RESULTS=false
RESULTS_FILE=./option_scan_results.json

# ============================================
# Performance Settings
# ============================================
# Number of concurrent API requests
CONCURRENT_REQUESTS=5

# Request timeout in seconds
REQUEST_TIMEOUT=30

# Retry attempts on failure
MAX_RETRIES=3
